          },
          "default": {
            "$ref": "#/components/responses/Problem"
          },
          "500": {
            "$ref": "./order.json#/components/responses/UnexpectedError"
          },
          "404": {
            "description": "ORDER_NOT_FOUND: absent or outside the permitted tenant/owner scope.",
            "headers": {
