      "get": {
        "tags": [
          "Orders"
        ],
        "operationId": "edgeListOwnOrders",
        "summary": "List the authenticated customer’s orders",
        "description": "Requires CUSTOMER; scopes tenant and authenticated subject. Deterministic descending (createdAt, id) keyset order; default 20, maximum 100. Newly created later orders do not shift continuation pages. Status is a live filter; results are not a multi-request snapshot. Date range is inclusive lower/exclusive upper. Unknown or repeated parameters are rejected, including tenantId/customerId. Invalid input returns 400 with INVALID_ORDER_LIMIT, INVALID_ORDER_CURSOR, INVALID_ORDER_STATUS, INVALID_ORDER_TIMESTAMP, INVALID_ORDER_DATE_RANGE or INVALID_ORDER_FILTER.",
        "parameters": [
          {
            "$ref": "./order.json#/components/parameters/CorrelationId"
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 20
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "schema": {
              "type": "string",
              "minLength": 39,
              "maxLength": 39
            },
            "description": "Opaque versioned token returned as nextCursor. Keep filters unchanged when following it."
          },
          {
            "name": "status",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "CREATED",
                "PENDING_PAYMENT",
                "CONFIRMED",
                "STOCK_REJECTED",
                "PAYMENT_FAILED",
                "CANCELLED",
                "EXPIRED"
              ]
            }
          },
          {
            "name": "createdFrom",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "date-time"
            },
            "description": "Inclusive creation timestamp, years 0001–9999."
          },
          {
            "name": "createdBefore",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "date-time"
            },
            "description": "Exclusive creation timestamp. Must be later than createdFrom."
          }
        ],
        "responses": {
          "200": {
            "description": "List the authenticated customer’s orders",
            "headers": {
              "X-Correlation-ID": {
                "$ref": "./order.json#/components/headers/CorrelationId"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./order.json#/components/schemas/OrderPage"
                }
              }
            }
          },
          "400": {
            "$ref": "./order.json#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "./order.json#/components/responses/Unauthenticated"
          },
          "403": {
            "$ref": "./order.json#/components/responses/Forbidden"
          },
          "413": {
            "$ref": "#/components/responses/Problem"
          },
          "415": {
            "$ref": "#/components/responses/Problem"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          },
          "502": {
            "$ref": "#/components/responses/Problem"
          },
          "503": {
            "$ref": "#/components/responses/Problem"
          },
          "504": {
            "$ref": "#/components/responses/Problem"
          },
          "default": {
            "$ref": "#/components/responses/Problem"
          },
          "500": {
            "$ref": "./order.json#/components/responses/UnexpectedError"
          }
        }
      }
    },
