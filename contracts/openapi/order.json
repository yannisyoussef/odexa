{
  "openapi": "3.1.0",
  "jsonSchemaDialect": "https://json-schema.org/draft/2020-12/schema",
  "info": {
    "title": "Odexa Order API",
    "version": "1.3.0",
    "description": "Multi-item checkout, owned customer queries and explicit tenant merchant views. Bearer JWTs validate issuer and odexa-api audience. CUSTOMER operations always scope tenant_id and sub; merchant operations require MERCHANT_ADMIN or MERCHANT_USER and scope tenant_id. Tenant/owner filters cannot be supplied by clients. No support/platform bypass. Responses contain no customer subject or provider references."
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "tags": [
    {
      "name": "Orders"
    }
  ],
  "paths": {
    "/api/v1/orders": {
      "post": {
        "tags": [
          "Orders"
        ],
        "operationId": "createOrder",
        "summary": "Accept a bounded basket with authoritative prices and semantic idempotency",
        "description": "Accepts one atomic basket asynchronously after one authenticated catalog batch snapshot. Missing/foreign product:404; inactive:409; zero total or overflow:422; invalid size/quantity, duplicate IDs, mixed forms or server-owned fields:400. At most20 distinct lines,100 units each. Legacy single-product input remains supported. Same key with reordered identical items replays; changed intent conflicts409.",
        "parameters": [
          {
            "$ref": "#/components/parameters/CorrelationId"
          },
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "description": "Case-sensitive opaque key containing 1 to 128 visible ASCII characters (U+0021 through U+007E; no spaces or controls). Reuse this key when retrying the same checkout, including after an ambiguous network failure.",
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[!-~]{1,128}$"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CheckoutRequest"
              },
              "example": {
                "items": [
                  {
                    "productId": "11111111-1111-4111-8111-111111111111",
                    "quantity": 2
                  },
                  {
                    "productId": "33333333-3333-4333-8333-333333333333",
                    "quantity": 1
                  }
                ],
                "paymentMethod": "pm_approved"
              }
            }
          }
        },
        "responses": {
          "201": {
            "$ref": "#/components/responses/CreatedOrder"
          },
          "200": {
            "$ref": "#/components/responses/ReplayedOrder"
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthenticated"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "description": "Product does not exist or is not accessible to this tenant (PRODUCT_NOT_FOUND).",
            "headers": {
              "X-Correlation-ID": {
                "$ref": "#/components/headers/CorrelationId"
              }
            },
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "409": {
            "description": "The scoped key already represents different intent (IDEMPOTENCY_CONFLICT), or a new checkout targets an inactive product (PRODUCT_UNAVAILABLE).",
            "headers": {
              "X-Correlation-ID": {
                "$ref": "#/components/headers/CorrelationId"
              }
            },
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "415": {
            "description": "Unsupported request media type.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "422": {
            "$ref": "#/components/responses/Problem"
          },
          "503": {
            "description": "Catalog timeout, transport failure, invalid authoritative snapshot, or upstream failure (CATALOG_UNAVAILABLE). No new order is persisted. Retrying an already persisted order does not require catalog availability.",
            "headers": {
              "X-Correlation-ID": {
                "$ref": "#/components/headers/CorrelationId"
              }
            },
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/UnexpectedError"
          }
        }
      },
      "get": {
        "tags": [
          "Orders"
        ],
        "operationId": "listOwnOrders",
        "summary": "List the authenticated customer\u2019s orders",
        "description": "Requires CUSTOMER; scopes tenant and authenticated subject. Deterministic descending (createdAt, id) keyset order; default 20, maximum 100. Newly created later orders do not shift continuation pages. Status is a live filter; results are not a multi-request snapshot. Date range is inclusive lower/exclusive upper. Unknown or repeated parameters are rejected, including tenantId/customerId. Invalid input returns 400 with INVALID_ORDER_LIMIT, INVALID_ORDER_CURSOR, INVALID_ORDER_STATUS, INVALID_ORDER_TIMESTAMP, INVALID_ORDER_DATE_RANGE or INVALID_ORDER_FILTER.",
        "parameters": [
          {
            "$ref": "#/components/parameters/CorrelationId"
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 20
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "schema": {
              "type": "string",
              "minLength": 39,
              "maxLength": 39
            },
            "description": "Opaque versioned token returned as nextCursor. Keep filters unchanged when following it."
          },
          {
            "name": "status",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "CREATED",
                "PENDING_PAYMENT",
                "CONFIRMED",
                "STOCK_REJECTED",
                "PAYMENT_FAILED",
                "CANCELLED",
                "EXPIRED"
              ]
            }
          },
          {
            "name": "createdFrom",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "date-time"
            },
            "description": "Inclusive creation timestamp, years 0001\u20139999."
          },
          {
            "name": "createdBefore",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "date-time"
            },
            "description": "Exclusive creation timestamp. Must be later than createdFrom."
          }
        ],
        "responses": {
          "200": {
            "description": "List the authenticated customer\u2019s orders",
            "headers": {
              "X-Correlation-ID": {
                "$ref": "#/components/headers/CorrelationId"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OrderPage"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthenticated"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "default": {
            "$ref": "#/components/responses/UnexpectedError"
          },
          "500": {
            "$ref": "#/components/responses/UnexpectedError"
          }
        }
      }
    },
    "/api/v1/orders/{id}": {
      "get": {
        "tags": [
          "Orders"
        ],
        "operationId": "getOrder",
        "summary": "Read the authenticated customer's order",
        "description": "Requires CUSTOMER. Looks up by order UUID AND JWT tenant_id AND JWT sub. Unknown IDs, cross-tenant IDs and another customer's IDs all return the same 404. Poll this resource for asynchronous state changes. Payment outcomes delivered before their inventory.reserved causation event are durably deferred: the visible status remains CREATED until that event is validated. Terminal states never move backwards or change in response to late contradictory outcomes.",
        "parameters": [
          {
            "$ref": "#/components/parameters/CorrelationId"
          },
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Current order snapshot. Payment method, customer identity, and internal causal evidence are not exposed.",
            "headers": {
              "X-Correlation-ID": {
                "$ref": "#/components/headers/CorrelationId"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Order"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthenticated"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "description": "Order is absent or not owned by the authenticated customer in this tenant (ORDER_NOT_FOUND).",
            "headers": {
              "X-Correlation-ID": {
                "$ref": "#/components/headers/CorrelationId"
              }
            },
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/UnexpectedError"
          }
        }
      }
    },
    "/api/v1/merchant/orders": {
      "get": {
        "tags": [
          "Orders"
        ],
        "operationId": "listMerchantOrders",
        "summary": "List orders within the merchant\u2019s tenant",
        "description": "Requires MERCHANT_ADMIN or MERCHANT_USER; includes all customers within this tenant. No identity/profile information is returned. Deterministic descending (createdAt, id) keyset order; default 20, maximum 100. Newly created later orders do not shift continuation pages. Status is a live filter; results are not a multi-request snapshot. Date range is inclusive lower/exclusive upper. Unknown or repeated parameters are rejected, including tenantId/customerId. Invalid input returns 400 with INVALID_ORDER_LIMIT, INVALID_ORDER_CURSOR, INVALID_ORDER_STATUS, INVALID_ORDER_TIMESTAMP, INVALID_ORDER_DATE_RANGE or INVALID_ORDER_FILTER.",
        "parameters": [
          {
            "$ref": "#/components/parameters/CorrelationId"
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 20
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "schema": {
              "type": "string",
              "minLength": 39,
              "maxLength": 39
            },
            "description": "Opaque versioned token returned as nextCursor. Keep filters unchanged when following it."
          },
          {
            "name": "status",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "CREATED",
                "PENDING_PAYMENT",
                "CONFIRMED",
                "STOCK_REJECTED",
                "PAYMENT_FAILED",
                "CANCELLED",
                "EXPIRED"
              ]
            }
          },
          {
            "name": "createdFrom",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "date-time"
            },
            "description": "Inclusive creation timestamp, years 0001\u20139999."
          },
          {
            "name": "createdBefore",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "date-time"
            },
            "description": "Exclusive creation timestamp. Must be later than createdFrom."
          }
        ],
        "responses": {
          "200": {
            "description": "List orders within the merchant\u2019s tenant",
            "headers": {
              "X-Correlation-ID": {
                "$ref": "#/components/headers/CorrelationId"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OrderPage"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthenticated"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "default": {
            "$ref": "#/components/responses/UnexpectedError"
          },
          "500": {
            "$ref": "#/components/responses/UnexpectedError"
          }
        }
      }
    },
    "/api/v1/merchant/orders/{id}": {
      "get": {
        "tags": [
          "Orders"
        ],
        "operationId": "getMerchantOrder",
        "summary": "Inspect one order within the merchant\u2019s tenant",
        "description": "Requires MERCHANT_ADMIN or MERCHANT_USER. No customer ownership bypass is added to the customer path.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "$ref": "#/components/parameters/CorrelationId"
          }
        ],
        "responses": {
          "200": {
            "description": "Inspect one order within the merchant\u2019s tenant",
            "headers": {
              "X-Correlation-ID": {
                "$ref": "#/components/headers/CorrelationId"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Order"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthenticated"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "default": {
            "$ref": "#/components/responses/UnexpectedError"
          },
          "500": {
            "$ref": "#/components/responses/UnexpectedError"
          },
          "404": {
            "description": "ORDER_NOT_FOUND: absent or outside the permitted tenant/owner scope.",
            "headers": {
              "X-Correlation-ID": {
                "$ref": "#/components/headers/CorrelationId"
              }
            },
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/orders/{id}/history": {
      "get": {
        "tags": [
          "Orders"
        ],
        "operationId": "getOwnOrderHistory",
        "summary": "Read order lifecycle history",
        "description": "Requires CUSTOMER and same tenant plus subject. State and history commit atomically. Ordered by lifecycle version; duplicates do not add entries. Legacy orders have an explicit migration-time observation followed by new transitions.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "$ref": "#/components/parameters/CorrelationId"
          }
        ],
        "responses": {
          "200": {
            "description": "Read order lifecycle history",
            "headers": {
              "X-Correlation-ID": {
                "$ref": "#/components/headers/CorrelationId"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OrderHistory"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthenticated"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "default": {
            "$ref": "#/components/responses/UnexpectedError"
          },
          "500": {
            "$ref": "#/components/responses/UnexpectedError"
          },
          "404": {
            "description": "ORDER_NOT_FOUND: absent or outside the permitted tenant/owner scope.",
            "headers": {
              "X-Correlation-ID": {
                "$ref": "#/components/headers/CorrelationId"
              }
            },
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/merchant/orders/{id}/history": {
      "get": {
        "tags": [
          "Orders"
        ],
        "operationId": "getMerchantOrderHistory",
        "summary": "Read order lifecycle history",
        "description": "Requires MERCHANT_ADMIN or MERCHANT_USER and same tenant. State and history commit atomically. Ordered by lifecycle version; duplicates do not add entries. Legacy orders have an explicit migration-time observation followed by new transitions.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "$ref": "#/components/parameters/CorrelationId"
          }
        ],
        "responses": {
          "200": {
            "description": "Read order lifecycle history",
            "headers": {
              "X-Correlation-ID": {
                "$ref": "#/components/headers/CorrelationId"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OrderHistory"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthenticated"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "default": {
            "$ref": "#/components/responses/UnexpectedError"
          },
          "500": {
            "$ref": "#/components/responses/UnexpectedError"
          },
          "404": {
            "description": "ORDER_NOT_FOUND: absent or outside the permitted tenant/owner scope.",
            "headers": {
              "X-Correlation-ID": {
                "$ref": "#/components/headers/CorrelationId"
              }
            },
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/orders/{id}/cancel": {
      "post": {
        "tags": [
          "Orders"
        ],
        "operationId": "cancelOwnOrder",
        "summary": "Cancel an owned checkout before dispatch begins",
        "description": "Requires CUSTOMER and tenant/owner match. No body or query parameters. Synchronously commits CANCELLED only when CREATED, without deferred payment evidence, and the durable publication fence proves checkout has never been attempted. Dispatch races are serialized by database locks. Already CANCELLED returns 200 with the same resource, including after restart. All other states or attempted/uncertain publication return 409 ORDER_NOT_CANCELLABLE; no stock is released and no payment reversed. No If-Match or separate Idempotency-Key is required: the command has no mutable payload and checks eligibility atomically. The cancellation fact references the withdrawn checkout event; the checkout event is never delivered.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "$ref": "#/components/parameters/CorrelationId"
          }
        ],
        "responses": {
          "200": {
            "description": "Cancel an owned checkout before dispatch begins",
            "headers": {
              "X-Correlation-ID": {
                "$ref": "#/components/headers/CorrelationId"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Order"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthenticated"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "default": {
            "$ref": "#/components/responses/UnexpectedError"
          },
          "500": {
            "$ref": "#/components/responses/UnexpectedError"
          },
          "404": {
            "description": "ORDER_NOT_FOUND: absent or outside the permitted tenant/owner scope.",
            "headers": {
              "X-Correlation-ID": {
                "$ref": "#/components/headers/CorrelationId"
              }
            },
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "409": {
            "description": "ORDER_NOT_CANCELLABLE: checkout may already have escaped or the order has another terminal/in-flight state.",
            "headers": {
              "X-Correlation-ID": {
                "$ref": "#/components/headers/CorrelationId"
              }
            },
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "OIDC issuer-validated JWT, audience odexa-api, UUID tenant_id, nonempty sub, and the realm_access.roles entry each operation requires: CUSTOMER for customer operations, MERCHANT_ADMIN or MERCHANT_USER for merchant operations."
      }
    },
    "parameters": {
      "CorrelationId": {
        "name": "X-Correlation-ID",
        "in": "header",
        "required": false,
        "description": "UUID correlation identifier; a new UUID is generated if absent. Propagated to catalog and events. Invalid non-UUID values are rejected.",
        "schema": {
          "type": "string",
          "format": "uuid"
        }
      }
    },
    "headers": {
      "CorrelationId": {
        "description": "Request correlation UUID.",
        "schema": {
          "type": "string",
          "format": "uuid"
        }
      },
      "OrderLocation": {
        "description": "Relative URI of the same order on creation and every exact retry.",
        "schema": {
          "type": "string",
          "format": "uri-reference",
          "pattern": "^/api/v1/orders/[0-9a-f-]{36}$"
        }
      }
    },
    "schemas": {
      "CheckoutRequest": {
        "type": "object",
        "required": [
          "paymentMethod"
        ],
        "properties": {
          "productId": {
            "type": "string",
            "format": "uuid",
            "deprecated": true
          },
          "quantity": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100,
            "deprecated": true
          },
          "paymentMethod": {
            "type": "string",
            "description": "Opaque provider reference only. Simulator scenario references or Stripe Test Mode PaymentMethod IDs; raw card data is rejected.",
            "pattern": "^pm_[A-Za-z0-9_]{1,125}$",
            "maxLength": 128
          },
          "items": {
            "type": "array",
            "minItems": 1,
            "maxItems": 20,
            "items": {
              "$ref": "#/components/schemas/CheckoutItem"
            },
            "description": "Distinct product IDs only; duplicates are rejected. Canonical UUID ordering makes reordering semantically equivalent. Up to 2000 total units."
          }
        },
        "additionalProperties": false,
        "oneOf": [
          {
            "required": [
              "productId",
              "quantity"
            ],
            "not": {
              "required": [
                "items"
              ]
            }
          },
          {
            "required": [
              "items"
            ],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "productId"
                  ]
                },
                {
                  "required": [
                    "quantity"
                  ]
                }
              ]
            }
          }
        ],
        "description": "Supply items OR the deprecated single-product fields, never both. Both normalize to one basket. Only purchase intent is accepted. Single-line keys replay across both shapes; item order is irrelevant."
      },
      "Order": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "totalMinor",
          "currency",
          "status",
          "version",
          "createdAt",
          "items"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "productId": {
            "type": "string",
            "format": "uuid",
            "deprecated": true,
            "description": "Present only for a one-line order; omitted for multi-item orders. Use items."
          },
          "quantity": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100,
            "deprecated": true,
            "description": "Present only for a one-line order; omitted for multi-item orders. Use items."
          },
          "totalMinor": {
            "type": "integer",
            "format": "int64",
            "minimum": 1,
            "maximum": 9223372036854775807,
            "description": "Strictly positive sum of immutable accepted line totals. Checked signed 64-bit multiplication and addition. A free line may accompany a paid line; a zero-total basket is rejected."
          },
          "currency": {
            "type": "string",
            "const": "USD"
          },
          "status": {
            "type": "string",
            "enum": [
              "CREATED",
              "PENDING_PAYMENT",
              "CONFIRMED",
              "STOCK_REJECTED",
              "PAYMENT_FAILED",
              "CANCELLED",
              "EXPIRED"
            ],
            "description": "CREATED awaits inventory and may already have payment in flight. PENDING_PAYMENT has reservation evidence. All other states are terminal. CANCELLED and EXPIRED apply only to never-dispatched checkout; uncertain payments never expire. Early payment evidence and its reservation may apply two transitions atomically, both recorded in history."
          },
          "version": {
            "type": "integer",
            "format": "int64",
            "minimum": 0,
            "maximum": 9223372036854775807,
            "description": "Starts at zero; increases once per domain state transition. Applying a deferred payment after its reservation increases by two. Duplicate or ignored late events do not increment it. Internal deferred evidence alone does not change the public version."
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "description": "Creation timestamp in UTC, normalized to database precision."
          },
          "items": {
            "type": "array",
            "minItems": 1,
            "maxItems": 20,
            "items": {
              "$ref": "#/components/schemas/OrderLine"
            }
          }
        },
        "oneOf": [
          {
            "required": [
              "productId",
              "quantity"
            ],
            "properties": {
              "items": {
                "maxItems": 1
              }
            }
          },
          {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "productId"
                  ]
                },
                {
                  "required": [
                    "quantity"
                  ]
                }
              ]
            },
            "properties": {
              "items": {
                "minItems": 2
              }
            }
          }
        ]
      },
      "Problem": {
        "type": "object",
        "description": "Sanitized RFC 9457 problem detail. Business problem types are https://odexa.cc/problems/{lowercase-code}. Additional transport metadata may be present.",
        "required": [
          "type",
          "title",
          "status",
          "code"
        ],
        "properties": {
          "type": {
            "type": "string",
            "format": "uri-reference"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "integer",
            "minimum": 400,
            "maximum": 599
          },
          "detail": {
            "type": "string"
          },
          "instance": {
            "type": "string",
            "format": "uri-reference"
          },
          "code": {
            "type": "string"
          }
        }
      },
      "OrderPage": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "items",
          "nextCursor"
        ],
        "properties": {
          "items": {
            "type": "array",
            "maxItems": 100,
            "items": {
              "$ref": "#/components/schemas/Order"
            }
          },
          "nextCursor": {
            "type": [
              "string",
              "null"
            ],
            "description": "Opaque next-page token, or null when no additional row matched at query time."
          }
        }
      },
      "OrderHistoryEntry": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "version",
          "status",
          "occurredAt",
          "reason"
        ],
        "properties": {
          "version": {
            "type": "integer",
            "minimum": 0
          },
          "status": {
            "type": "string",
            "enum": [
              "CREATED",
              "PENDING_PAYMENT",
              "CONFIRMED",
              "STOCK_REJECTED",
              "PAYMENT_FAILED",
              "CANCELLED",
              "EXPIRED"
            ]
          },
          "occurredAt": {
            "type": "string",
            "format": "date-time",
            "description": "UTC local transition recording time; nondecreasing by version. LEGACY_SNAPSHOT time is migration observation time, not an inferred historic transition."
          },
          "reason": {
            "type": "string",
            "enum": [
              "ORDER_CREATED",
              "STOCK_RESERVED",
              "INSUFFICIENT_STOCK",
              "PAYMENT_AUTHORIZED",
              "PAYMENT_DECLINED",
              "CUSTOMER_CANCELLED",
              "DISPATCH_EXPIRED",
              "LEGACY_SNAPSHOT"
            ]
          }
        }
      },
      "OrderHistory": {
        "type": "array",
        "maxItems": 4,
        "items": {
          "$ref": "#/components/schemas/OrderHistoryEntry"
        },
        "description": "Ascending version; bounded by the acyclic lifecycle. No Kafka metadata. Complete for new orders; old orders begin with a LEGACY_SNAPSHOT."
      },
      "CheckoutItem": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "productId",
          "quantity"
        ],
        "properties": {
          "productId": {
            "type": "string",
            "format": "uuid"
          },
          "quantity": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          }
        }
      },
      "OrderLine": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "productId",
          "quantity",
          "productName",
          "unitPriceMinor",
          "lineTotalMinor",
          "catalogVersion"
        ],
        "properties": {
          "productId": {
            "type": "string",
            "format": "uuid"
          },
          "quantity": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "productName": {
            "type": "string",
            "minLength": 1
          },
          "unitPriceMinor": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9223372036854775807
          },
          "lineTotalMinor": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9223372036854775807
          },
          "catalogVersion": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "responses": {
      "CreatedOrder": {
        "description": "New order durably created with its outbox event.",
        "headers": {
          "Location": {
            "$ref": "#/components/headers/OrderLocation"
          },
          "X-Correlation-ID": {
            "$ref": "#/components/headers/CorrelationId"
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Order"
            }
          }
        }
      },
      "ReplayedOrder": {
        "description": "Existing matching order; same ID and Location, current state; no new order or order.created event.",
        "headers": {
          "Location": {
            "$ref": "#/components/headers/OrderLocation"
          },
          "X-Correlation-ID": {
            "$ref": "#/components/headers/CorrelationId"
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Order"
            }
          }
        }
      },
      "BadRequest": {
        "description": "Malformed input or a stable query validation code: INVALID_ORDER_LIMIT, INVALID_ORDER_CURSOR, INVALID_ORDER_STATUS, INVALID_ORDER_TIMESTAMP, INVALID_ORDER_DATE_RANGE, INVALID_ORDER_FILTER. Unknown/repeated query parameters are rejected on collections; cancellation accepts no parameters/body.",
        "headers": {
          "X-Correlation-ID": {
            "$ref": "#/components/headers/CorrelationId"
          }
        },
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        }
      },
      "Unauthenticated": {
        "description": "Missing or invalid bearer token, including issuer/audience validation failures.",
        "headers": {
          "X-Correlation-ID": {
            "$ref": "#/components/headers/CorrelationId"
          }
        },
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        }
      },
      "Forbidden": {
        "description": "Required operation role or valid tenant/subject claims are missing. Merchant views require MERCHANT_ADMIN or MERCHANT_USER; customer operations require CUSTOMER. No implicit support/platform access.",
        "headers": {
          "X-Correlation-ID": {
            "$ref": "#/components/headers/CorrelationId"
          }
        },
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        }
      },
      "UnexpectedError": {
        "description": "Sanitized unexpected server error.",
        "headers": {
          "X-Correlation-ID": {
            "$ref": "#/components/headers/CorrelationId"
          }
        },
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        }
      },
      "Problem": {
        "description": "Coded Problem Details",
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        }
      }
    }
  }
}
